{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "video-published.v1.schema.json",
  "title": "VideoPublished v1",
  "description": "Publicado pelo Upload no tópico video.published quando o vídeo termina de ser processado e está pronto para reprodução. Chave da mensagem: videoId.",
  "allOf": [{ "$ref": "envelope.schema.json" }],
  "properties": {
    "type": { "const": "VideoPublished" },
    "version": { "const": 1 },
    "payload": {
      "type": "object",
      "required": ["videoId", "ownerId", "title", "visibility", "durationSec", "hlsBucket", "masterKey", "renditions", "publishedAt"],
      "properties": {
        "videoId": { "type": "string", "minLength": 1 },
        "ownerId": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "visibility": { "enum": ["PUBLIC", "UNLISTED", "PRIVATE"] },
        "durationSec": { "type": "integer", "minimum": 1 },
        "hlsBucket": { "type": "string", "minLength": 1 },
        "masterKey": {
          "description": "Caminho do master.m3u8 dentro do bucket, ex.: 456/master.m3u8.",
          "type": "string",
          "minLength": 1
        },
        "renditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "width", "height", "bandwidth"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "width": { "type": "integer", "minimum": 1 },
              "height": { "type": "integer", "minimum": 1 },
              "bandwidth": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "thumbnailKey": { "type": "string" },
        "publishedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}

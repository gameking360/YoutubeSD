{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Confluent.Kafka": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "ConsumerGroup": "identity",
    "MaxAttempts": 3,
    "Topics": {
      "ReserveRequested": "quota.reserve-requested",
      "Reserved": "quota.reserved",
      "Rejected": "quota.rejected",
      "ReleaseRequested": "quota.release-requested",
      "VideoPublished": "video.published"
    }
  },
  "Identity": {
    "DefaultQuotaLimit": 10,
    "AdminToken": "",
    "InternalApiKey": ""
  }
}

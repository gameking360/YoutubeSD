{
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" },
    "Console": { "FormatterName": "simple", "FormatterOptions": { "IncludeScopes": true } }
  },
  "AllowedHosts": "*",
  "Security": {
    "Issuer": "youtubesd-security",
    "Audience": "youtubesd-api",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "IdentityBaseUrl": "http://identityService",
    "IdentityTimeoutSeconds": 5
  }
}

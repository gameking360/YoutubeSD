{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Confluent.Kafka": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "mediaDb": "Server=localhost;Port=3306;User ID=root;Password=root123;Database=media_db"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "ConsumerGroup": "media-processor",
    "MaxAttempts": 3
  },
  "S3": {
    "ServiceUrl": "http://localhost:4566",
    "Region": "us-east-1",
    "AccessKey": "test",
    "SecretKey": "test"
  },
  "Processor": {
    "Concurrency": 1,
    "MaxAttempts": 3,
    "FfmpegThreads": 0,
    "Preset": "veryfast",
    "SegmentSeconds": 4,
    "JobTimeoutMinutes": 120,
    "UploadParallelism": 8
  }
}

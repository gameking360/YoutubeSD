{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Confluent.Kafka": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "uploadDb": "Server=localhost;Port=3306;User ID=root;Password=root123;Database=upload_db"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "ConsumerGroup": "upload",
    "MaxAttempts": 3
  },
  "S3": {
    "ServiceUrl": "http://localhost:4566",
    "Region": "us-east-1",
    "AccessKey": "test",
    "SecretKey": "test",
    "RawBucket": "videos-raw",
    "HlsBucket": "videos-hls"
  },
  "Upload": {
    "ChunkSizeBytes": 8388608,
    "MaxFileSizeBytes": 10737418240,
    "MaxConcurrentParts": 8,
    "AllowedExtensions": "mp4,mov,mkv,webm,avi,m4v",
    "Saga": {
      "QueueTimeoutMinutes": 30,
      "ProcessingBaseSeconds": 60,
      "ProcessingSecondsPerMb": 1,
      "ProcessingMaxMinutes": 120,
      "UploadIdleTimeoutMinutes": 60,
      "SweepIntervalSeconds": 5
    }
  },
  "Jwt": {
    "JwksUri": "http://localhost:8080/api/auth/.well-known/jwks.json",
    "Issuer": "youtubesd-security",
    "Audience": "youtubesd-api",
    "RequireHttpsMetadata": false
  }
}
